# Public browser configuration. Copy to .env.local for local development.
# Use only the project URL and anon/publishable key from Supabase API settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. GitHub Pages uses hash routes by default.
# Set browser only on hosting with an SPA rewrite to index.html.
VITE_ROUTER_MODE=hash

# Build-process setting normally supplied by GitHub Pages metadata.
# PAGES_BASE_PATH=/pixel-wedding-rsvp/

# Never add a service-role/secret key, database password or JWT signing secret.
# VITE_* variables are visible in the public compiled website.
